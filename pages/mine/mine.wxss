.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.user-section {
  background: #fff;
  padding: 32rpx;
  margin-bottom: 16rpx;
}

.user-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.user-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #f0f0f0;
  flex-shrink: 0;
}

.user-detail { flex: 1; }
.user-name { font-size: 32rpx; font-weight: 700; color: #000; display: block; margin-bottom: 6rpx; }
.user-sub { font-size: 24rpx; color: #999; }
.logout-btn { font-size: 26rpx; color: #ff4d4f; }

.login-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.default-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  flex-shrink: 0;
}

.login-info { flex: 1; }
.login-title { font-size: 32rpx; font-weight: 600; color: #000; display: block; margin-bottom: 4rpx; }
.login-sub { font-size: 24rpx; color: #999; }
.arrow { font-size: 36rpx; color: #ccc; }

.stats-section {
  background: #fff;
  display: flex;
  align-items: center;
  padding: 32rpx;
  margin-bottom: 16rpx;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value { font-size: 44rpx; font-weight: 800; color: #1890ff; }
.stat-label { font-size: 24rpx; color: #999; margin-top: 6rpx; }

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: #f0f0f0;
}

.menu-section {
  background: #fff;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-icon { font-size: 36rpx; margin-right: 20rpx; }
.menu-text { flex: 1; font-size: 30rpx; color: #333; }
.menu-arrow { font-size: 36rpx; color: #ccc; }
