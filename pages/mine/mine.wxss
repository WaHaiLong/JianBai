.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* ===== 品牌Logo区 ===== */
.logo-section {
  background: linear-gradient(135deg, #1890ff 0%, #69b1ff 50%, #69b1ff 100%);
  padding: 40rpx 32rpx 48rpx;
  border-radius: 0 0 32rpx 32rpx;
  position: relative;
  overflow: hidden;
}

.logo-section::before {
  content: '';
  position: absolute;
  top: -80rpx;
  right: -40rpx;
  width: 240rpx;
  height: 240rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 50%;
}

.logo-section::after {
  content: '';
  position: absolute;
  bottom: -60rpx;
  right: 60rpx;
  width: 160rpx;
  height: 160rpx;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 50%;
}

.logo-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  z-index: 1;
}

.logo-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.logo-icon-wrapper {
  width: 80rpx;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.3);
}

.logo-icon {
  width: 64rpx;
  height: 64rpx;
}

.logo-text-group {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.logo-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: 2rpx;
}

.logo-subtitle {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  letter-spacing: 1rpx;
}

.logo-badge {
  background: rgba(255, 255, 255, 0.2);
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  border-radius: 24rpx;
  padding: 8rpx 20rpx;
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
}

.badge-text {
  font-size: 22rpx;
  color: #ffffff;
  font-weight: 600;
}

.user-section {
  background: #fff;
  padding: 32rpx;
  margin: 16rpx;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.user-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.user-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #f0f0f0;
  flex-shrink: 0;
}

.user-detail { flex: 1; }
.user-name { font-size: 32rpx; font-weight: 700; color: #000; display: block; margin-bottom: 6rpx; }
.user-sub { font-size: 24rpx; color: #999; }
.logout-btn { font-size: 26rpx; color: #ff4d4f; }

.login-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.default-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  flex-shrink: 0;
}

.login-info { flex: 1; }
.login-title { font-size: 32rpx; font-weight: 600; color: #000; display: block; margin-bottom: 4rpx; }
.login-sub { font-size: 24rpx; color: #999; }
.arrow { font-size: 36rpx; color: #ccc; }

.stats-section {
  background: #fff;
  display: flex;
  align-items: center;
  padding: 32rpx;
  margin-bottom: 16rpx;
  border-radius: 20rpx;
  margin: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.stat-item:not(:last-child)::after {
  content: '';
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 1rpx;
  height: 48rpx;
  background: #f0f0f0;
}

.stat-value {
  font-size: 52rpx;
  font-weight: 900;
  background: linear-gradient(135deg, #1890ff, #69b1ff);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
  font-weight: 500;
}

.menu-section {
  background: #fff;
  margin: 16rpx;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
  transition: background 0.15s;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: #f8f8f8;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
  width: 48rpx;
  text-align: center;
}

.menu-text { flex: 1; font-size: 30rpx; color: #333; font-weight: 500; }
.menu-arrow { font-size: 36rpx; color: #ccc; }
