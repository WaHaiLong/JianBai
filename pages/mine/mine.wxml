<view class="container">
  <!-- 品牌Logo区 -->
  <view class="logo-section">
    <view class="logo-banner">
      <view class="logo-left">
        <view class="logo-icon-wrapper">
          <image class="logo-icon" src="/assets/icons/logo.svg" mode="aspectFit" />
        </view>
        <view class="logo-text-group">
          <text class="logo-title">健百</text>
          <text class="logo-subtitle">JianBai · 智能健身</text>
        </view>
      </view>
      <view class="logo-badge">
        <text class="badge-text">v2.0</text>
      </view>
    </view>
  </view>

  <!-- 用户信息区 -->
  <view class="user-section">
    <view wx:if="{{userInfo}}" class="user-info">
      <image class="user-avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill" />
      <view class="user-detail">
        <text class="user-name">{{userInfo.nickName}}</text>
        <text class="user-sub">坚持训练，成为更好的自己</text>
      </view>
      <text class="logout-btn" bindtap="onLogout">退出</text>
    </view>
    <view wx:else class="login-card" bindtap="onLogin">
      <view class="default-avatar">👤</view>
      <view class="login-info">
        <text class="login-title">点击登录</text>
        <text class="login-sub">记录你的训练历程</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>

  <!-- 训练统计 -->
  <view class="stats-section">
    <view class="stat-item">
      <text class="stat-value">{{stats.totalWorkouts}}</text>
      <text class="stat-label">训练次数</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">{{stats.totalVolume}}</text>
      <text class="stat-label">总训练量</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">{{stats.activeChallenges}}</text>
      <text class="stat-label">进行中挑战</text>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <view class="menu-item" bindtap="onTestDbTap">
      <text class="menu-icon">🧪</text>
      <text class="menu-text">测试数据库</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onSettingsTap">
      <text class="menu-icon">⚙️</text>
      <text class="menu-text">设置</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onFeedbackTap">
      <text class="menu-icon">💬</text>
      <text class="menu-text">意见反馈</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onAboutTap">
      <text class="menu-icon">ℹ️</text>
      <text class="menu-text">关于健百</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>
</view>

<!-- 自定义TabBar -->
<custom-tab-bar />
