.container {
  height: 100vh;
  background-color: #f5f5f5;
  display: flex;
  flex-direction: column;
}

.empty-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
}

.empty-icon { font-size: 100rpx; margin-bottom: 24rpx; }
.empty-text { font-size: 32rpx; color: #333; font-weight: 700; margin-bottom: 12rpx; }
.empty-sub { font-size: 26rpx; color: #999; text-align: center; line-height: 1.6; }

.history-list {
  flex: 1;
  padding: 16rpx;
}

.history-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 0;
  margin-bottom: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 14rpx rgba(0, 0, 0, 0.06);
}

/* 卡片顶部蓝色渐变条 */
.history-card::before {
  display: none;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 24rpx 24rpx 16rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.card-info { flex: 1; }

.card-date {
  font-size: 22rpx;
  color: #bbb;
  display: block;
  margin-bottom: 6rpx;
}

.card-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #000;
}

.card-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.card-duration {
  font-size: 24rpx;
  color: #1890ff;
  background: #e8f4ff;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.delete-btn {
  font-size: 28rpx;
  color: #ccc;
  padding: 4rpx 8rpx;
}

.exercise-summary {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  padding: 16rpx 24rpx;
}

.summary-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: #f5f5f5;
  border-radius: 10rpx;
  padding: 8rpx 16rpx;
}

.summary-name { font-size: 24rpx; color: #555; font-weight: 500; }
.summary-sets { font-size: 22rpx; color: #999; }
.summary-video { font-size: 22rpx; }

.card-footer {
  border-top: 1rpx solid #f5f5f5;
  padding: 12rpx 24rpx;
}

.card-count { font-size: 24rpx; color: #bbb; }

/* 详情弹窗 */
.detail-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.detail-panel {
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  width: 100%;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}

/* 拖动指示条 */
.detail-panel::before {
  content: '';
  display: block;
  width: 64rpx;
  height: 8rpx;
  background: #e0e0e0;
  border-radius: 4rpx;
  margin: 0 auto 28rpx;
}

.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.detail-title { font-size: 36rpx; font-weight: 800; color: #000; }
.detail-close {
  font-size: 28rpx;
  color: #999;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
  border-radius: 50%;
}
.detail-date { font-size: 26rpx; color: #999; margin-bottom: 24rpx; display: block; }

.detail-exercises { flex: 1; }

.detail-exercise {
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.detail-ex-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.detail-ex-name { font-size: 30rpx; font-weight: 700; color: #333; }

.video-btn {
  background: #e8f4ff;
  color: #1890ff;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-weight: 500;
}

/* 视频列表 */
.detail-video-list {
  background: #fafafa;
  border-radius: 12rpx;
  padding: 4rpx 0;
  margin-bottom: 12rpx;
}

.detail-video-item {
  display: flex;
  align-items: center;
  padding: 12rpx 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.detail-video-item:last-child {
  border-bottom: none;
}

.detail-video-icon {
  color: #1890ff;
  font-size: 22rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.detail-video-name {
  font-size: 26rpx;
  color: #333;
}

.detail-sets { display: flex; flex-direction: column; gap: 8rpx; }

.detail-set {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 10rpx 12rpx;
  border-radius: 10rpx;
  background: #fafafa;
}

.detail-set-num { font-size: 24rpx; color: #999; width: 80rpx; }
.detail-set-weight { font-size: 26rpx; color: #333; flex: 1; font-weight: 500; }
.detail-set-reps { font-size: 26rpx; color: #333; flex: 1; font-weight: 500; }
.detail-set-done { font-size: 28rpx; color: #52c41a; width: 40rpx; text-align: center; }
