.container {
  height: 100vh;
  background-color: #f5f5f5;
  display: flex;
  flex-direction: column;
}

.empty-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
}

.empty-icon { font-size: 100rpx; margin-bottom: 24rpx; }
.empty-text { font-size: 32rpx; color: #333; font-weight: 600; margin-bottom: 12rpx; }
.empty-sub { font-size: 26rpx; color: #999; text-align: center; }

.history-list {
  flex: 1;
  padding: 16rpx;
}

.history-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.card-info { flex: 1; }

.card-date { font-size: 24rpx; color: #999; display: block; margin-bottom: 6rpx; }
.card-name { font-size: 32rpx; font-weight: 700; color: #000; }

.card-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.card-duration { font-size: 24rpx; color: #1890ff; }

.delete-btn {
  font-size: 28rpx;
  color: #ccc;
  padding: 4rpx 8rpx;
}

.exercise-summary {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.summary-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  padding: 8rpx 16rpx;
}

.summary-name { font-size: 24rpx; color: #333; }
.summary-sets { font-size: 22rpx; color: #999; }
.summary-video { font-size: 22rpx; }

.card-footer { border-top: 1rpx solid #f0f0f0; padding-top: 12rpx; }
.card-count { font-size: 24rpx; color: #999; }

/* 详情弹窗 */
.detail-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.detail-panel {
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  width: 100%;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}

.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.detail-title { font-size: 36rpx; font-weight: 700; color: #000; }
.detail-close { font-size: 32rpx; color: #999; padding: 8rpx; }
.detail-date { font-size: 26rpx; color: #999; margin-bottom: 24rpx; display: block; }

.detail-exercises { flex: 1; }

.detail-exercise {
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.detail-ex-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.detail-ex-name { font-size: 30rpx; font-weight: 600; color: #333; }

.video-btn {
  background: #e8f4ff;
  color: #1890ff;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
}

/* 视频列表 */
.detail-video-list {
  background: #fafafa;
  border-radius: 8rpx;
  padding: 4rpx 0;
  margin-bottom: 12rpx;
}

.detail-video-item {
  display: flex;
  align-items: center;
  padding: 12rpx 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.detail-video-item:last-child {
  border-bottom: none;
}

.detail-video-icon {
  color: #1890ff;
  font-size: 22rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.detail-video-name {
  font-size: 26rpx;
  color: #333;
}

.detail-sets { display: flex; flex-direction: column; gap: 8rpx; }

.detail-set {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 8rpx 0;
}

.detail-set-num { font-size: 24rpx; color: #999; width: 80rpx; }
.detail-set-weight { font-size: 26rpx; color: #333; flex: 1; }
.detail-set-reps { font-size: 26rpx; color: #333; flex: 1; }
.detail-set-done { font-size: 28rpx; color: #52c41a; width: 40rpx; text-align: center; }
