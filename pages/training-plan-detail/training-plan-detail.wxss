/* pages/training-plan-detail/training-plan-detail.wxss */
.container {
  min-height: 100vh;
  background: #F7FAFC;
  padding: 20rpx;
}

/* 计划概览 */
.plan-overview {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.plan-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.plan-title {
  font-size: 42rpx;
  font-weight: 700;
  color: #2D3748;
  font-family: 'Noto Sans SC', sans-serif;
}

.plan-status {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  background: #E2E8F0;
  color: #718096;
  font-family: 'PingFang SC', sans-serif;
}

.plan-status.active {
  background: #48BB78;
  color: #FFFFFF;
}

.plan-desc {
  font-size: 28rpx;
  color: #718096;
  line-height: 1.6;
  display: block;
  margin-bottom: 32rpx;
  font-family: 'PingFang SC', sans-serif;
}

.plan-stats {
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 24rpx 0;
  border-top: 1rpx solid #E2E8F0;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #FF6B35;
  font-family: 'Noto Sans SC', sans-serif;
}

.stat-label {
  font-size: 24rpx;
  color: #718096;
  font-family: 'PingFang SC', sans-serif;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: #E2E8F0;
}

/* 进度卡片 */
.progress-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.progress-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2D3748;
  font-family: 'PingFang SC', sans-serif;
}

.progress-percentage {
  font-size: 40rpx;
  font-weight: 700;
  color: #FF6B35;
  font-family: 'Noto Sans SC', sans-serif;
}

.progress-bar-large {
  height: 24rpx;
  background: #E2E8F0;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.progress-fill-large {
  height: 100%;
  background: linear-gradient(90deg, #FF6B35 0%, #FF8C42 100%);
  border-radius: 12rpx;
  transition: width 0.5s ease;
}

.progress-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.progress-text {
  font-size: 28rpx;
  color: #2D3748;
  font-family: 'PingFang SC', sans-serif;
}

.progress-remaining {
  font-size: 28rpx;
  color: #718096;
  font-family: 'PingFang SC', sans-serif;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.btn {
  flex: 1;
  height: 88rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: 'PingFang SC', sans-serif;
}

.btn-primary {
  background: linear-gradient(135deg, #FF6B35 0%, #FF8C42 100%);
  color: #FFFFFF;
}

.btn-outline {
  background: transparent;
  border: 3rpx solid #FF6B35;
  color: #FF6B35;
}

.btn-disabled {
  background: #E2E8F0;
  color: #A0AEC0;
}

/* 训练记录列表 */
.workouts-section {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2D3748;
  font-family: 'Noto Sans SC', sans-serif;
}

.section-count {
  font-size: 28rpx;
  color: #718096;
  font-family: 'PingFang SC', sans-serif;
}

.workout-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.workout-card {
  display: flex;
  gap: 24rpx;
  padding: 24rpx;
  background: #F7FAFC;
  border-radius: 16rpx;
  align-items: center;
}

.workout-date {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #FF6B35 0%, #FF8C42 100%);
  border-radius: 16rpx;
  justify-content: center;
}

.date-day {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
  font-family: 'Noto Sans SC', sans-serif;
}

.date-month {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.8);
  font-family: 'PingFang SC', sans-serif;
}

.workout-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.workout-exercises {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.exercise-count {
  font-size: 28rpx;
  font-weight: 600;
  color: #2D3748;
  font-family: 'PingFang SC', sans-serif;
}

.exercise-duration {
  font-size: 24rpx;
  color: #718096;
  font-family: 'PingFang SC', sans-serif;
}

.workout-meta {
  display: flex;
  gap: 24rpx;
}

.workout-calories,
.workout-sets {
  font-size: 24rpx;
  color: #718096;
  font-family: 'PingFang SC', sans-serif;
}

/* 空状态 */
.empty-workouts {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #718096;
  margin-bottom: 12rpx;
  font-family: 'PingFang SC', sans-serif;
}

.empty-hint {
  font-size: 24rpx;
  color: #A0AEC0;
  font-family: 'PingFang SC', sans-serif;
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 80vh;
  gap: 24rpx;
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 4rpx solid #E2E8F0;
  border-top-color: #FF6B35;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  font-size: 28rpx;
  color: #718096;
  font-family: 'PingFang SC', sans-serif;
}
