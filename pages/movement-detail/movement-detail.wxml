<view class="container" wx:if="{{exercise}}">
  <!-- 动作演示区 -->
  <view class="demo-area">
    <!-- 视频播放器 -->
    <video
      wx:if="{{currentVideoSrc}}"
      class="exercise-video"
      src="{{currentVideoSrc}}"
      controls
      autoplay
    />
    <!-- 无视频时的占位 -->
    <view class="demo-placeholder" wx:elif="{{videos.length === 0}}">
      <text class="demo-emoji">🏋️</text>
      <view class="demo-actions">
        <view class="demo-btn" bindtap="onPlayVideo" wx:if="{{exercise.hasTutorial}}">
          <text>▶ 观看讲解</text>
        </view>
        <view class="demo-btn demo-btn-outline" bindtap="onRecordVideo">
          <text>📹 录制动作</text>
        </view>
      </view>
    </view>
    <!-- 有视频但未选中播放时 -->
    <view class="demo-placeholder" wx:else>
      <text class="demo-emoji">🎬</text>
      <text class="demo-hint">点击下方列表查看视频</text>
    </view>
  </view>

  <!-- 视频操作栏 -->
  <view class="video-action-bar">
    <view class="video-action-left">
      <text class="video-count">📹 我的视频 ({{videos.length}})</text>
    </view>
    <view class="video-action-right">
      <view class="upload-btn" bindtap="onRecordVideo">
        <text>＋ 上传视频</text>
      </view>
    </view>
  </view>

  <!-- 视频列表 -->
  <view class="video-list" wx:if="{{videos.length > 0}}">
    <view class="video-item" wx:for="{{videos}}" wx:key="fileID">
      <view class="video-item-main" bindtap="onPlayListItem" data-index="{{index}}">
        <view class="video-item-icon">▶</view>
        <view class="video-item-info">
          <text class="video-item-name">视频 {{videos.length - index}}</text>
          <text class="video-item-time">{{item.timeStr}}</text>
        </view>
        <view class="video-item-playing" wx:if="{{currentVideoSrc === item.tempFileURL}}">
          <text>播放中</text>
        </view>
      </view>
      <view class="video-item-delete" catchtap="onDeleteVideo" data-index="{{index}}">
        <text>删除</text>
      </view>
    </view>
  </view>

  <!-- 空视频提示 -->
  <view class="video-empty" wx:if="{{videos.length === 0}}">
    <text class="video-empty-text">还没有上传过视频</text>
    <text class="video-empty-hint">点击上方"录制动作"开始录制</text>
  </view>

  <!-- 动作信息 -->
  <view class="info-section">
    <!-- 标题与标签 -->
    <view class="info-header">
      <text class="exercise-title">{{exercise.name}}</text>
      <view class="tags">
        <view class="tag tag-blue" wx:if="{{exercise.hasTutorial}}">讲解</view>
        <view class="tag tag-orange" wx:if="{{exercise.hasMultiAngle}}">多角度</view>
        <view class="tag tag-difficulty">{{exercise.difficulty === 'beginner' ? '初级' : exercise.difficulty === 'intermediate' ? '中级' : '高级'}}</view>
      </view>
    </view>

    <!-- 主要肌肉 -->
    <view class="muscle-section">
      <view class="section-label">主要肌肉</view>
      <view class="muscle-tags">
        <text class="muscle-tag primary" wx:for="{{exercise.primaryMuscles}}" wx:key="*this">{{item}}</text>
      </view>
    </view>

    <!-- 协同肌肉 -->
    <view class="muscle-section" wx:if="{{exercise.secondaryMuscles.length > 0}}">
      <view class="section-label">协同肌肉</view>
      <view class="muscle-tags">
        <text class="muscle-tag secondary" wx:for="{{exercise.secondaryMuscles}}" wx:key="*this">{{item}}</text>
      </view>
    </view>

    <!-- 描述 -->
    <view class="description-section">
      <view class="section-label">动作说明</view>
      <text class="description-text">{{exercise.description}}</text>
    </view>

    <!-- 要点提示 -->
    <view class="tips-section">
      <view class="section-label">动作要点</view>
      <view class="tips-list">
        <view class="tip-item" wx:for="{{exercise.tips}}" wx:key="*this">
          <text class="tip-dot">•</text>
          <text class="tip-text">{{item}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar">
    <view class="add-workout-btn" bindtap="onAddToWorkout">
      <text>添加到训练计划</text>
    </view>
  </view>
</view>

<view class="not-found" wx:else>
  <text>动作不存在</text>
</view>
