.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: #f5f5f5;
}

.demo-area {
  background-color: #1a1a2e;
  height: 480rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.demo-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}

.demo-emoji {
  font-size: 120rpx;
  margin-bottom: 32rpx;
}

.demo-actions {
  display: flex;
  gap: 24rpx;
}

.demo-btn {
  background-color: #1890ff;
  color: #fff;
  padding: 16rpx 32rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
}

.demo-btn-outline {
  background-color: transparent;
  border: 2rpx solid #fff;
  color: #fff;
}

.exercise-video {
  width: 100%;
  height: 480rpx;
}

.info-section {
  background-color: #fff;
  margin: 16rpx;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 160rpx;
}

.info-header {
  margin-bottom: 24rpx;
}

.exercise-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #000;
  display: block;
  margin-bottom: 12rpx;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.tag {
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.tag-blue {
  background-color: #1890ff;
  color: #fff;
}

.tag-orange {
  background-color: #ff7a00;
  color: #fff;
}

.tag-difficulty {
  background-color: #f0f5ff;
  color: #1890ff;
}

.muscle-section {
  margin-bottom: 20rpx;
}

.section-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.muscle-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.muscle-tag {
  padding: 8rpx 20rpx;
  border-radius: 40rpx;
  font-size: 24rpx;
}

.muscle-tag.primary {
  background-color: #ff4d4f20;
  color: #cf1322;
  border: 1rpx solid #ffccc7;
}

.muscle-tag.secondary {
  background-color: #f0f0f0;
  color: #666;
}

.description-section {
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.description-text {
  font-size: 28rpx;
  color: #555;
  line-height: 1.8;
}

.tips-section {}

.tips-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.tip-item {
  display: flex;
  align-items: flex-start;
}

.tip-dot {
  color: #1890ff;
  font-size: 28rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.tip-text {
  font-size: 28rpx;
  color: #555;
  line-height: 1.6;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background-color: #fff;
  border-top: 1rpx solid #f0f0f0;
}

.add-workout-btn {
  background-color: #1890ff;
  color: #fff;
  text-align: center;
  padding: 24rpx;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.not-found {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100vh;
  color: #999;
  font-size: 28rpx;
}
