<!--pages/test-db/test-db.wxml-->
<view class="container">
  <view class="header">
    <text class="title">云数据库测试</text>
    <text class="status" wx:if="{{isConnected}}">✅ 已连接</text>
    <text class="status error" wx:else>❌ 未连接</text>
  </view>

  <!-- 登录状态提示 -->
  <view class="section" wx:if="{{!hasUser}}">
    <text class="section-title warning">⚠️ 未登录</text>
    <button class="btn primary large" bindtap="onLogin">授权登录</button>
    <text class="hint">需要先登录才能使用数据库功能</text>
  </view>

  <view class="section">
    <text class="section-title">测试操作</text>
    <button class="btn" bindtap="testConnection">测试连接</button>
    <button class="btn primary" bindtap="testDirectAdd">直接添加记录（原生API）</button>
    <button class="btn" bindtap="testCreateUser">创建测试用户</button>
    <button class="btn" bindtap="testSaveWorkout">保存测试记录（封装）</button>
    <button class="btn" bindtap="testGetWorkouts">获取训练记录</button>
    <button class="btn" bindtap="testChallenge">测试挑战</button>
    <button class="btn" bindtap="testFavorite">测试收藏</button>
    <button class="btn" bindtap="readCloudLogs">📋 读取云端日志</button>
    <button class="btn danger" bindtap="clearAllData">清空所有数据</button>
  </view>

  <view class="section">
    <text class="section-title">测试结果</text>
    <view class="log-box">
      <text class="log" wx:for="{{logs}}" wx:key="index">
        {{item}}
      </text>
    </view>
  </view>

  <view class="section" wx:if="{{workouts.length > 0}}">
    <text class="section-title">训练记录 ({{workouts.length}})</text>
    <view class="workout-list">
      <view class="workout-item" wx:for="{{workouts}}" wx:key="workoutId">
        <text class="workout-name">{{item.name}}</text>
        <text class="workout-date">{{item.date}}</text>
        <text class="workout-volume">训练量: {{item.totalVolume}}</text>
      </view>
    </view>
  </view>
</view>
