.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f5f5f5;
}

/* ===== 未开始状态 ===== */
.empty-training {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
  background: linear-gradient(180deg, #fff 0%, #f5f5f5 100%);
}

.empty-icon {
  font-size: 128rpx;
  margin-bottom: 40rpx;
  filter: drop-shadow(0 8rpx 16rpx rgba(24, 144, 255, 0.2));
}

.empty-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #000;
  margin-bottom: 16rpx;
  letter-spacing: 1rpx;
}

.empty-subtitle {
  font-size: 28rpx;
  color: #999;
  text-align: center;
  margin-bottom: 72rpx;
  line-height: 1.7;
  max-width: 480rpx;
}

.start-btn {
  background: linear-gradient(135deg, #1890ff 0%, #40a9ff 100%);
  color: #fff;
  padding: 30rpx 96rpx;
  border-radius: 56rpx;
  font-size: 34rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 28rpx rgba(24, 144, 255, 0.4);
  letter-spacing: 2rpx;
}

.start-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

/* ===== 计时栏 ===== */
.timer-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx 20rpx;
  background-color: #fff;
  border-bottom: 3rpx solid #1890ff;
  flex-shrink: 0;
  box-shadow: 0 2rpx 12rpx rgba(24, 144, 255, 0.1);
}

.timer-info {
  display: flex;
  flex-direction: column;
}

.timer-label {
  font-size: 20rpx;
  color: #999;
  margin-bottom: 2rpx;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.timer-value {
  font-size: 52rpx;
  font-weight: 800;
  color: #000;
  font-variant-numeric: tabular-nums;
  letter-spacing: 2rpx;
}

.timer-actions {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.cancel-btn {
  padding: 16rpx 32rpx;
  border: 2rpx solid #ff4d4f;
  color: #ff4d4f;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.cancel-btn:active {
  background: #fff1f0;
}

.finish-btn {
  padding: 16rpx 36rpx;
  background: linear-gradient(135deg, #1890ff 0%, #40a9ff 100%);
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 4rpx 14rpx rgba(24, 144, 255, 0.35);
}

.finish-btn:active {
  opacity: 0.9;
}

/* ===== 休息计时器 ===== */
.rest-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx;
  background: linear-gradient(135deg, #e8f4ff, #bae7ff);
  border-bottom: 1rpx solid #91d5ff;
  flex-shrink: 0;
}

.rest-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.rest-label {
  font-size: 26rpx;
  color: #0050b3;
  font-weight: 500;
}

.rest-timer {
  font-size: 38rpx;
  font-weight: 800;
  color: #1890ff;
  font-variant-numeric: tabular-nums;
}

.rest-skip {
  font-size: 26rpx;
  color: #1890ff;
  border: 2rpx solid #1890ff;
  padding: 10rpx 28rpx;
  border-radius: 32rpx;
  font-weight: 500;
  background: rgba(255, 255, 255, 0.6);
}

/* ===== 动作列表 ===== */
.exercise-list {
  flex: 1;
  padding: 16rpx;
}

.exercise-item {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.exercise-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.exercise-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #000;
  flex: 1;
}

.exercise-header-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.record-btn {
  font-size: 26rpx;
  padding: 8rpx 18rpx;
  background-color: #f5f5f5;
  border-radius: 10rpx;
  color: #666;
}

.record-btn-done {
  background-color: #f0fff4;
  color: #389e0d;
}

.play-btn {
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  background-color: #e8f4ff;
  border-radius: 10rpx;
  color: #1890ff;
}

/* ===== 视频子列表 ===== */
.video-sub-list {
  background-color: #fafafa;
  border-radius: 12rpx;
  padding: 8rpx 0;
  margin-bottom: 14rpx;
  border: 1rpx solid #f0f0f0;
}

.video-sub-item {
  display: flex;
  align-items: center;
  padding: 14rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.video-sub-item:last-child {
  border-bottom: none;
}

.video-sub-icon {
  color: #1890ff;
  font-size: 22rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.video-sub-name {
  font-size: 26rpx;
  color: #333;
  flex: 1;
}

.video-sub-time {
  font-size: 22rpx;
  color: #bbb;
  flex-shrink: 0;
}

.delete-btn {
  font-size: 30rpx;
  color: #ccc;
  padding: 6rpx 10rpx;
}

.exercise-muscles {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.muscle-badge {
  font-size: 22rpx;
  color: #cf1322;
  background-color: #fff1f0;
  padding: 5rpx 14rpx;
  border-radius: 20rpx;
  border: 1rpx solid #ffa39e;
}

/* ===== 组数表格 ===== */
.set-header {
  display: flex;
  align-items: center;
  padding: 10rpx 0 12rpx;
  border-bottom: 2rpx solid #f0f0f0;
  margin-bottom: 4rpx;
}

.set-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #fafafa;
  border-radius: 8rpx;
  transition: background-color 0.2s;
}

.set-row-done {
  background-color: #f6ffed;
  border-radius: 10rpx;
  padding: 14rpx 10rpx;
}

.set-col-num {
  width: 56rpx;
  text-align: center;
  font-size: 26rpx;
  color: #666;
  flex-shrink: 0;
  font-weight: 600;
}

.set-col-prev {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #bbb;
}

.set-col-weight {
  flex: 1.5;
  text-align: center;
  font-size: 26rpx;
  color: #333;
}

.set-col-reps {
  flex: 1.2;
  text-align: center;
  font-size: 26rpx;
  color: #333;
}

.set-col-done {
  width: 64rpx;
  text-align: center;
  font-size: 22rpx;
  color: #ccc;
  flex-shrink: 0;
}

.set-input {
  background-color: #f5f5f5;
  border-radius: 10rpx;
  padding: 10rpx 8rpx;
  text-align: center;
  margin: 0 8rpx;
  font-size: 28rpx;
}

.set-done-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 2rpx solid #d9d9d9;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 4rpx;
  font-size: 24rpx;
  color: #d9d9d9;
  flex-shrink: 0;
  transition: all 0.2s;
}

.set-done-active {
  background: linear-gradient(135deg, #52c41a, #73d13d);
  border-color: #52c41a;
  color: #fff;
  box-shadow: 0 2rpx 8rpx rgba(82, 196, 26, 0.35);
}

/* ===== 添加按钮 ===== */
.add-set-btn {
  text-align: center;
  padding: 18rpx;
  margin-top: 8rpx;
  color: #1890ff;
  font-size: 26rpx;
  border: 2rpx dashed #91d5ff;
  border-radius: 12rpx;
  background: #fafeff;
}

.add-exercise-btn {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 36rpx;
  text-align: center;
  color: #1890ff;
  font-size: 30rpx;
  font-weight: 600;
  border: 2rpx dashed #91d5ff;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(24, 144, 255, 0.06);
}
