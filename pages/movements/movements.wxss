/* 整体容器 */
.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f5f5f5;
  position: relative;
}

/* ===== 搜索栏 ===== */
.search-header {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx 16rpx;
  background-color: #fff;
  padding-top: calc(20rpx + env(safe-area-inset-top));
}

.search-bar {
  flex: 1;
  margin-right: 16rpx;
}

.search-box {
  display: flex;
  align-items: center;
  background-color: #f2f2f7;
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
  height: 72rpx;
  box-sizing: border-box;
}

.search-icon-text {
  font-size: 28rpx;
  margin-right: 12rpx;
  color: #999;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  background: transparent;
  border: none;
}

.search-clear {
  font-size: 24rpx;
  color: #999;
  padding: 4rpx 8rpx;
}

.add-btn {
  width: 72rpx;
  height: 72rpx;
  background-color: #1890ff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.add-icon {
  color: #fff;
  font-size: 40rpx;
  line-height: 1;
  font-weight: 300;
}

/* ===== 主体布局 ===== */
.main-content {
  display: flex;
  flex: 1;
  overflow: hidden;
  position: relative;
}

/* ===== 左侧肌肉群导航 ===== */
.muscle-nav {
  width: 120rpx;
  background-color: #f5f5f5;
  height: 100%;
  flex-shrink: 0;
}

.muscle-item {
  padding: 22rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #666;
  position: relative;
  line-height: 1.4;
}

.muscle-item-active {
  color: #333;
  font-weight: 600;
  background-color: #fff;
  border-radius: 0;
}

.muscle-item-active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 40rpx;
  background-color: #1890ff;
  border-radius: 0 4rpx 4rpx 0;
}

.sub-item {
  padding: 16rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #999;
  background-color: #fff;
}

.sub-item-active {
  color: #1890ff;
  font-weight: 500;
}

/* ===== 右侧内容区 ===== */
.content-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  background-color: #fff;
  overflow: hidden;
  margin-right: 48rpx; /* 给右侧快捷导航留空间 */
}

/* ===== 器械Tab ===== */
.equipment-tabs {
  padding: 16rpx 16rpx 0;
  background-color: #fff;
  border-bottom: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}

.tab-scroll {
  width: 100%;
  white-space: nowrap;
}

.tab-list {
  display: flex;
  flex-direction: row;
}

.tab-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 24rpx;
  margin-right: 8rpx;
  margin-bottom: 12rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #666;
  background-color: #f5f5f5;
  white-space: nowrap;
  flex-shrink: 0;
}

.tab-item-active {
  color: #1890ff;
  background-color: #e8f4ff;
  font-weight: 500;
}

/* ===== 动作区标题 ===== */
.section-title {
  padding: 20rpx 24rpx 8rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #000;
  flex-shrink: 0;
}

/* ===== 动作网格 ===== */
.exercise-scroll {
  flex: 1;
  overflow: hidden;
}

.exercise-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 8rpx 16rpx 200rpx;
  gap: 16rpx;
}

.exercise-card {
  width: calc(50% - 8rpx);
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid #f0f0f0;
}

/* 动作角标 */
.card-badge {
  position: absolute;
  top: 0;
  left: 0;
  background-color: #1890ff;
  color: #fff;
  font-size: 18rpx;
  padding: 6rpx 12rpx;
  border-radius: 0 0 12rpx 0;
  z-index: 1;
}

.card-badge-orange {
  background-color: #ff7a00;
}

/* 动作图示占位 */
.exercise-image-placeholder {
  width: 100%;
  height: 180rpx;
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.exercise-emoji {
  font-size: 64rpx;
}

/* 动作名称 */
.exercise-name {
  display: block;
  padding: 12rpx 16rpx 16rpx;
  font-size: 26rpx;
  color: #333;
  text-align: center;
  line-height: 1.4;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* ===== 右侧快捷导航 ===== */
.side-nav {
  position: absolute;
  right: 0;
  top: 64rpx;
  width: 44rpx;
  display: flex;
  flex-direction: column;
  z-index: 10;
}

.side-nav-item {
  width: 44rpx;
  padding: 8rpx 0;
  text-align: center;
  font-size: 20rpx;
  color: #1890ff;
  line-height: 1.5;
  cursor: pointer;
}

.side-nav-item-active {
  font-weight: 700;
  color: #0050b3;
}

/* ===== 悬浮按钮 ===== */
.float-btn {
  position: fixed;
  right: 32rpx;
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  width: 104rpx;
  height: 104rpx;
  background-color: #1890ff;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(24, 144, 255, 0.4);
  z-index: 100;
}

.float-btn-text {
  font-size: 22rpx;
  color: #fff;
  font-weight: 600;
  line-height: 1.4;
}
