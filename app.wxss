/* 全局样式 */
page {
  background-color: #f5f5f5;
  font-family: -apple-system, PingFangSC, 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  color: #333;
}

/* 通用卡片 */
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
}

/* 主色 */
.color-primary { color: #1890ff; }
.bg-primary { background-color: #1890ff; }

/* 辅助色 */
.color-gray { color: #999; }
.color-light-gray { color: #ccc; }
.color-success { color: #52c41a; }
.color-danger { color: #ff4d4f; }

/* 文字大小 */
.text-xl { font-size: 44rpx; font-weight: 700; }
.text-lg { font-size: 36rpx; }
.text-md { font-size: 28rpx; }
.text-sm { font-size: 24rpx; }
.text-xs { font-size: 20rpx; }

/* 字重 */
.font-bold { font-weight: 700; }
.font-semibold { font-weight: 600; }

/* 布局 */
.flex { display: flex; }
.flex-col { flex-direction: column; }
.flex-center { align-items: center; justify-content: center; }
.flex-between { justify-content: space-between; }
.flex-wrap { flex-wrap: wrap; }
.flex-1 { flex: 1; }
.items-center { align-items: center; }

/* 间距 */
.mt-8 { margin-top: 8rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mb-8 { margin-bottom: 8rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-24 { margin-bottom: 24rpx; }
.ml-16 { margin-left: 16rpx; }
.mr-16 { margin-right: 16rpx; }
.p-16 { padding: 16rpx; }
.p-24 { padding: 24rpx; }
.px-24 { padding-left: 24rpx; padding-right: 24rpx; }
.py-16 { padding-top: 16rpx; padding-bottom: 16rpx; }

/* 分割线 */
.divider {
  height: 1rpx;
  background-color: #f0f0f0;
  margin: 16rpx 0;
}

/* 标签 */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  font-size: 20rpx;
  font-weight: 500;
}

.tag-blue {
  background-color: #e8f4ff;
  color: #1890ff;
}

.tag-orange {
  background-color: #fff4e8;
  color: #ff7a00;
}

.tag-green {
  background-color: #f0fff4;
  color: #52c41a;
}

.tag-red {
  background-color: #fff1f0;
  color: #ff4d4f;
}

/* 按钮 */
.btn-primary {
  background: linear-gradient(135deg, #1890ff 0%, #40a9ff 100%);
  color: #fff;
  border-radius: 48rpx;
  padding: 24rpx 48rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 6rpx 20rpx rgba(24, 144, 255, 0.35);
}

.btn-primary:active {
  opacity: 0.9;
}

.btn-outline {
  border: 2rpx solid #1890ff;
  color: #1890ff;
  border-radius: 48rpx;
  padding: 22rpx 48rpx;
  text-align: center;
  font-size: 28rpx;
  background: transparent;
}

.btn-danger {
  border: 2rpx solid #ff4d4f;
  color: #ff4d4f;
  border-radius: 48rpx;
  padding: 22rpx 48rpx;
  text-align: center;
  font-size: 28rpx;
  background: transparent;
}

/* 搜索框 */
.search-box {
  display: flex;
  align-items: center;
  background: #f2f2f7;
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
  flex: 1;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  background: transparent;
}

/* 节标题 */
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx 16rpx;
}

.section-title-text {
  font-size: 34rpx;
  font-weight: 700;
  color: #000;
}

.section-link {
  font-size: 26rpx;
  color: #1890ff;
}
